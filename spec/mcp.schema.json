{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agents-mcp.dev/schema/v0.1.0/mcp.schema.json",
  "title": "Unified Agents MCP Configuration",
  "description": "Canonical MCP server configuration for AI coding agents.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "servers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "stdio"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "disabled": {
                "type": "boolean"
              },
              "targets": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "claude-code",
                    "cursor",
                    "vscode",
                    "opencode",
                    "windsurf",
                    "zed"
                  ]
                }
              }
            },
            "required": [
              "transport",
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "http"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "disabled": {
                "type": "boolean"
              },
              "targets": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "claude-code",
                    "cursor",
                    "vscode",
                    "opencode",
                    "windsurf",
                    "zed"
                  ]
                }
              }
            },
            "required": [
              "transport",
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "$schema",
    "servers"
  ],
  "additionalProperties": false
}

{
  "name": "agents-mcp",
  "version": "0.0.0",
  "description": "One .agents/mcp.json to rule them all. A tool-agnostic specification and CLI compiler for managing Model Context Protocol (MCP) servers across any AI agent.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-config",
    "ai-agents",
    "coding-agents",
    "agents",
    "claude-code",
    "cursor",
    "vscode",
    "opencode",
    "windsurf",
    "zed",
    "cli",
    "config-sync",
    "jsonc",
    "dotenv",
    "devtools"
  ],
  "homepage": "https://github.com/agents-mcp/cli#readme",
  "bugs": {
    "url": "https://github.com/agents-mcp/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agents-mcp/cli.git"
  },
  "license": "MIT",
  "author": "Alex Bruno Cáceres <email@alexbruno.dev>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:gen": "tsx scripts/generate-schema.ts",
    "schema:check": "tsx scripts/generate-schema.ts --check",
    "verify": "run-s typecheck format:check test schema:check build",
    "prepublishOnly": "node -e \"console.error('❌ Error: Do not publish from the root! Use: npm run dist'); process.exit(1)\"",
    "dist:build": "npm run verify",
    "dist:package": "tsx package.ts",
    "dist:publish": "npm publish ./dist",
    "dist": "run-s dist:*"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "citty": "^0.2.2",
    "jsonc-parser": "^3.3.1",
    "string-argv": "^0.4.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
